// ADSA Reimberg Mídias - Prisma Schema
// Central de Mídia ADSA Reimberg
// Stack: PostgreSQL via Prisma Client (Supabase)
// Fases cobertas: 1 (Fundação) + 2 (Eventos) + 3 (Artes) + 4 (Galeria) + Telão + Backup

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================================

model Profile {
  id            String   @id @default(cuid())
  nome          String
  email         String   @unique
  senhaHash     String
  avatar        String?
  perfil        String   @default("equipe_midia") // administrador | editor | aprovador | fotografo | equipe_midia | visitante
  status        String   @default("ativo") // ativo | suspenso | inativo
  ultimoAcesso  DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  eventosCriados       Event[]       @relation("EventCreator")
  eventosAtualizados   Event[]       @relation("EventUpdater")
  auditLogs            AuditLog[]
  approvals            Approval[]
  feedbacks            ProductFeedback[]
  mediaEnviados        MediaAsset[]  @relation("MediaSender")
  mediaAprovados       MediaAsset[]  @relation("MediaApprover")
  albunsCriados        Album[]       @relation("AlbumCreator")
  fotosEnviadas        AlbumPhoto[]  @relation("PhotoSender")
  fotosAprovadas       AlbumPhoto[]  @relation("PhotoApprover")

  @@index([perfil])
  @@index([status])
}

// ============================================================
// CONFIGURAÇÕES DA IGREJA
// ============================================================

model ChurchSettings {
  id                  String   @id @default(cuid())
  nomeDaIgreja        String   @default("ADSA Praise")
  nomeDaAplicacao     String   @default("PraiseHub")
  subtitulo           String   @default("Central de Mídia ADSA Praise")
  textoPrincipal      String   @default("Artes, fotos e materiais oficiais da ADSA Praise, organizados em um só lugar.")
  textoComplementar   String   @default("Consulte o próximo culto, encontre as versões atualizadas e baixe os materiais necessários para divulgação e utilização na igreja.")
  logo                String?
  icone               String?
  imagemDeCapa        String?
  corPrimaria         String   @default("#0F2A5C") // azul profundo
  corDestaque         String   @default("#C9A227") // dourado suave
  endereco            String?
  fusoHorario         String   @default("America/Sao_Paulo")
  configuracoesAcesso String   @default("{}") // JSON livre
  atualizadoEm        DateTime @updatedAt
}

// ============================================================
// HORÁRIOS DE CULTOS (recorrentes)
// ============================================================

model ServiceSchedule {
  id            String   @id @default(cuid())
  nome          String   // ex.: Celebração da Família
  diaSemana     Int      // 0=Dom, 1=Seg, 2=Ter, 3=Qua, 4=Qui, 5=Sex, 6=Sáb
  horarioInicio String   // "18:00"
  horarioFim    String?  // "20:00"
  categoria     String?  // ex.: culto, ebd, especial
  descricao     String?
  ativo         Boolean  @default(true)
  ordem         Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([ativo])
  @@index([diaSemana])
}

// ============================================================
// CATEGORIAS DE EVENTOS
// ============================================================

model EventCategory {
  id    String  @id @default(cuid())
  nome  String  @unique
  icone String?
  ativo Boolean @default(true)
  ordem Int     @default(0)

  eventos Event[]

  @@index([ativo])
}

// ============================================================
// EVENTOS / CULTOS
// ============================================================

model Event {
  id              String   @id @default(cuid())
  nome            String
  slug            String   @unique
  categoriaId     String?
  descricao       String?
  data            DateTime
  horarioInicio   String   // "19:30"
  horarioFim      String?
  local           String?
  endereco        String?
  tema            String?
  versiculo       String?
  pregador        String?
  ministerio      String?
  capa            String?
  status          String   @default("rascunho")
  // rascunho | em_producao | aguardando_aprovacao | ajustes_solicitados | aprovado | programado | publicado | encerrado | arquivado | cancelado
  visibilidade   String   @default("publico") // publico | somente_equipe | somente_autenticados | privado
  destaqueManual Boolean  @default(false)
  publicadoEm    DateTime?
  observacoesInternas String?
  criadoPorId    String?
  criadoEm       DateTime @default(now())
  atualizadoPorId String?
  atualizadoEm   DateTime @updatedAt

  categoria      EventCategory? @relation(fields: [categoriaId], references: [id])
  criadoPor      Profile?       @relation("EventCreator", fields: [criadoPorId], references: [id])
  atualizadoPor  Profile?       @relation("EventUpdater", fields: [atualizadoPorId], references: [id])
  mediaAssets    MediaAsset[]
  albuns         Album[]

  @@index([status])
  @@index([visibilidade])
  @@index([data])
  @@index([destaqueManual])
}

// ============================================================
// APROVAÇÕES, AUDITORIA, FEEDBACK
// ============================================================

model Approval {
  id            String   @id @default(cuid())
  tipoConteudo  String   // evento | media_asset | album_photo
  conteudoId    String
  versao        Int      @default(1)
  decisao       String   // aprovado | reprovado | ajustes
  comentario    String?
  usuarioId     String?
  criadoEm      DateTime @default(now())

  usuario       Profile? @relation(fields: [usuarioId], references: [id])

  @@index([tipoConteudo, conteudoId])
}

model AuditLog {
  id              String   @id @default(cuid())
  usuarioId       String?
  acao            String   // criar | atualizar | publicar | arquivar | restaurar | excluir
  entidade        String   // evento | categoria | profile | church_settings
  entidadeId      String?
  descricao       String
  dadosAnteriores String?  // JSON
  dadosPosteriores String? // JSON
  ip              String?
  criadoEm        DateTime @default(now())

  usuario         Profile? @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

model ProductFeedback {
  id             String   @id @default(cuid())
  usuarioId      String?
  categoria      String   // sugestao | erro | melhoria | dificuldade
  descricao      String
  status         String   @default("pendente") // pendente | em_analise | aprovado | rejeitado
  decisaoAdmin   String?
  criadoEm       DateTime @default(now())
  analisadoEm    DateTime?

  usuario        Profile? @relation(fields: [usuarioId], references: [id])

  @@index([status])
}

// ============================================================
// CENTRAL DE ARTES (Fase 3)
// ============================================================

model MediaAsset {
  id                String   @id @default(cuid())
  eventoId          String
  nome              String
  tipo              String   // whatsapp | rede_social | banner_telao | outros
  status            String   @default("rascunho")
  // rascunho | em_aprovacao | aprovado | publicado | arquivado
  visibilidade      String   @default("publico") // publico | privado
  versaoAtual       Int      @default(1)
  textoDeDivulgacao String?
  observacoes       String?
  enviadoPorId      String?
  aprovadoPorId     String?
  aprovadoEm        DateTime?
  publicadoEm       DateTime?
  quantidadeDownloads Int    @default(0)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  evento            Event    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  enviadoPor        Profile? @relation("MediaSender", fields: [enviadoPorId], references: [id])
  aprovadoPor       Profile? @relation("MediaApprover", fields: [aprovadoPorId], references: [id])
  versoes           MediaVersion[]

  @@index([eventoId])
  @@index([tipo])
  @@index([status])
}

model MediaVersion {
  id                String   @id @default(cuid())
  mediaAssetId      String
  numeroDaVersao    Int
  caminhoDoArquivo  String   // caminho relativo em public/uploads/...
  caminhoThumbnail  String?  // versão miniatura para galeria
  nomeOriginal      String
  nomePadronizado   String
  extensao          String
  mimeType          String
  tamanho           Int      // bytes
  largura           Int?
  altura            Int?
  checksum          String?
  arquivoOficial    Boolean  @default(false)
  enviadoPorId      String?
  enviadoEm         DateTime @default(now())

  mediaAsset        MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
  @@index([arquivoOficial])
}

// ============================================================
// GALERIA DE FOTOS (Fase 4)
// ============================================================

model Album {
  id                  String   @id @default(cuid())
  eventoId            String?
  nome                String
  slug                String   @unique
  descricao           String?
  fotografo           String?
  capaPhotoId         String?  // referência para a foto capa (opcional, sem relation direto p/ evitar ciclo)
  status              String   @default("rascunho")
  // rascunho | publicado | arquivado
  visibilidade        String   @default("publico")
  // publico | somente_equipe | somente_autenticados | privado
  permitirDownload    Boolean  @default(true)
  aceitarContribuicoes Boolean @default(false)
  criadoPorId         String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt
  publicadoEm         DateTime?

  evento              Event?   @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  criadoPor           Profile? @relation("AlbumCreator", fields: [criadoPorId], references: [id])
  fotos               AlbumPhoto[]

  @@index([eventoId])
  @@index([status])
  @@index([visibilidade])
}

model AlbumPhoto {
  id                String   @id @default(cuid())
  albumId           String
  caminhoOriginal   String
  caminhoOtimizado  String?  // versão otimizada para web
  caminhoThumbnail  String?  // miniatura para grid
  nomeOriginal      String
  legenda           String?
  ordem             Int      @default(0)
  status            String   @default("publicado")
  // rascunho | publicado | arquivado
  enviadoPorId      String?
  enviadoEm         DateTime @default(now())
  aprovadoPorId     String?
  aprovadoEm        DateTime?
  largura           Int?
  altura            Int?
  tamanho           Int?
  mimeType          String?

  album             Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  enviadoPor        Profile? @relation("PhotoSender", fields: [enviadoPorId], references: [id])
  aprovadoPor       Profile? @relation("PhotoApprover", fields: [aprovadoPorId], references: [id])

  @@index([albumId])
  @@index([ordem])
}
